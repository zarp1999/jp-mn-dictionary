{
  "expo": {
    "name": "NichiMo",
    "slug": "jp-mn-dictionary",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.dariabazar.jpmn-dictionary",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "e-Paper単語帳へお気に入り単語を送信するためにローカルネットワークを使います。",
        "NSPhotoLibraryUsageDescription": "写真に写っている日本語の文字を読み取って辞書で調べるために、写真へのアクセスを使います。",
        "NSCameraUsageDescription": "看板や教科書などをカメラで撮影し、日本語の文字を読み取って辞書で調べるために、カメラを使います。",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-asset",
      "japanese-tokenizer",
      "digital-ink",
      [
        "expo-image-picker",
        {
          "cameraPermission": "看板や教科書などをカメラで撮影し、日本語の文字を読み取って辞書で調べるために、カメラを使います。",
          "photosPermission": "写真に写っている日本語の文字を読み取って辞書で調べるために、写真へのアクセスを使います。"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6b92ff55-71ef-46fc-9a52-a6f7fe46d69f"
      }
    }
  }
}
